# DeepSeek API（可选）。设置后将用 deepseek-chat 生成茶农白话建议；
# 未设置时自动降级为内置规则模板，离线 Demo 仍可用。
DEEPSEEK_API_KEY=

# 管理令牌（可选）：保护 /api/refresh 与 /api/reports。未设置时这些接口返回 403（更安全）。
ADMIN_TOKEN=

# 传感器上报令牌（可选）：保护 /api/sensor*。未设置时回退使用 ADMIN_TOKEN。
SENSOR_TOKEN=

# 告警通知 webhook（可选）：设置后，告警变化时 POST。默认发通用 JSON；
# 用 Slack/飞书/钉钉时把 ALERT_WEBHOOK_KIND 设为对应值即可（无需改代码）。
ALERT_WEBHOOK_URL=
# 渠道类型（可选，默认 generic）：generic / slack / feishu / dingtalk
ALERT_WEBHOOK_KIND=generic
# 钉钉加签密钥（可选，仅 dingtalk 且开启加签时填）
ALERT_WEBHOOK_SECRET=

# 数据陈旧阈值（分钟，可选，默认 120）：超过则在页面/API 标记 stale（应略大于刷新周期）。
STALE_MINUTES=120

# 自研问答内部超时（秒，可选，默认 20）：超时返回安全兜底，避免长尾阻塞。
ASK_TIMEOUT=20

# 外部数据库（可选）：如 sqlite:///data/teawindow.db 指向持久卷；生产建议托管数据库。
DATABASE_URL=

# 预报数据源（可选，默认 auto）：auto=Open-Meteo 优先、失败自动回退 MET Norway；
# metno=强制首选 MET Norway（免费、免密钥，规避 Open-Meteo 免费档共享出口 IP 限流 429）。
FORECAST_SOURCE=auto

# Open-Meteo 商业 key（可选）：仅付费订阅（customer 端点）才有；免费档无 key。
# 注意 Standard 档不含历史/集合/归档 API，需 Professional 及以上。留空即用免费档。
OPEN_METEO_API_KEY=

# HTTP User-Agent（可选）：MET Norway 要求可识别应用 + 联系方式，请改成你的邮箱/主页。
HTTP_UA=TeaWindow/1.0 (AI4Climate Meijiawu tea-garden; contact: 2302372846@qq.com)
