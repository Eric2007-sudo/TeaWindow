# DeepSeek API（可选）。设置后将用 deepseek-chat 生成茶农白话建议；
# 未设置时自动降级为内置规则模板，离线 Demo 仍可用。
DEEPSEEK_API_KEY=

# 管理令牌（可选）：保护 /api/refresh 与 /api/reports。未设置时这些接口返回 403（更安全）。
ADMIN_TOKEN=

# 传感器上报令牌（可选）：保护 /api/sensor*。未设置时回退使用 ADMIN_TOKEN。
SENSOR_TOKEN=

# 告警通知 webhook（可选）：设置后，告警变化时 POST JSON（Slack/钉钉/飞书/自建均可）。
ALERT_WEBHOOK_URL=

# 数据陈旧阈值（分钟，可选，默认 150）：超过则在页面/API 标记 stale。
STALE_MINUTES=150

# 自研问答内部超时（秒，可选，默认 20）：超时返回安全兜底，避免长尾阻塞。
ASK_TIMEOUT=20

# 外部数据库（可选）：如 sqlite:///data/teawindow.db 指向持久卷；生产建议托管数据库。
DATABASE_URL=
